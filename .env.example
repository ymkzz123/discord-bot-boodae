# Discord Developer Portal > General Information > Application ID
DISCORD_CLIENT_ID=

# Discord Developer Portal > Bot > Token (never commit the real value)
DISCORD_TOKEN=

# Required: comma-separated Discord server IDs where this private bot may run.
# Commands and one locked invite URL per server are generated from this list.
# Enable Discord Developer Mode, then right-click each server > Copy Server ID.
DISCORD_ALLOWED_GUILD_IDS=

# Legacy single-server setting. It is optional and merged into the list above.
DISCORD_GUILD_ID=

# Google AI Studio API key (never commit the real value)
GEMINI_API_KEY=

# Free-tier text model used to summarize externally collected search results.
GEMINI_MODEL=gemini-3.1-flash-lite

SEARCH_TIMEOUT_MS=60000
SEARCH_MAX_RESULTS=5

# Naver Sports KBO collector timeout and in-memory cache.
KBO_TIMEOUT_MS=10000
KBO_CACHE_SECONDS=30

CONVERSATION_TTL_MINUTES=30
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
MAX_RESPONSE_CHARS=10000
LOG_LEVEL=info
