# Discord Developer Portal > General Information > Application ID
DISCORD_CLIENT_ID=

# Discord Developer Portal > Bot > Token (never commit the real value)
DISCORD_TOKEN=

# Optional: register commands instantly in one development server and preselect
# that server when running `npm run invite:url`.
# Enable Discord Developer Mode, then right-click the server > Copy Server ID.
# Leave blank to register globally and choose a server during installation.
DISCORD_GUILD_ID=

# OpenAI Platform API key (never commit the real value)
OPENAI_API_KEY=

# Official web-search documentation currently recommends gpt-5.5 for new integrations.
OPENAI_MODEL=gpt-5.5

SEARCH_TIMEOUT_MS=60000
CONVERSATION_TTL_MINUTES=30
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
MAX_RESPONSE_CHARS=10000
LOG_LEVEL=info
